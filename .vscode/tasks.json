{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "qmake",
            "type": "shell",
            "command": "mkdir -p build/vscode && cd build/vscode && qmake ../../AVGRobot.pro",
            "group": "build",
            "problemMatcher": [],
            "options": {
                "cwd": "${workspaceFolder}"
            }
        },
        {
            "label": "make",
            "type": "shell",
            "command": "make",
            "args": [
                "-j4"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "dependsOn": [
                "qmake"
            ],
            "problemMatcher": [
                "$gcc"
            ],
            "options": {
                "cwd": "${workspaceFolder}/build/vscode"
            }
        },
        {
            "label": "Clean",
            "type": "shell",
            "command": "mkdir -p build/vscode && cd build/vscode && make clean",
            "group": "build",
            "options": {
                "cwd": "${workspaceFolder}"
            }
        },
        {
            "label": "Run",
            "type": "shell",
            "command": "./AVGRobot",
            "group": "test",
            "dependsOn": [
                "make"
            ],
            "options": {
                "cwd": "${workspaceFolder}/build/vscode"
            }
        }
    ]
}
